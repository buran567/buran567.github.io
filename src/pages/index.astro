---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Icon, Label } from 'astro-pure/user'
import avatar from '@/assets/avatar.svg'
import PageLayout from '@/layouts/BaseLayout.astro'

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const posts = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: '首页' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-6' id='content-header'>
      <img
        src={avatar.src}
        alt='Buran'
        class='h-28 w-28 rounded-full border p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-3'>
        <h1 class='text-3xl font-medium'>Buran</h1>
        <p
          class='max-w-md text-center text-muted-foreground'
          data-en='Notes, thoughts and fragments of an ordinary life.'
        >
          记录一些想法、笔记和生活片段。
        </p>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='GitHub' as='a' href='https://github.com/buran567' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <section class='flex flex-col gap-y-3'>
        <div class='flex items-baseline justify-between'>
          <h2 class='text-xl font-medium' data-en='Latest posts'>最新文章</h2>
          <a
            href='/archives'
            class='text-sm text-muted-foreground transition-colors hover:text-primary'
            data-en='All posts →'
          >
            全部文章 →
          </a>
        </div>
        {
          posts.length > 0 ? (
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {posts.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
          ) : (
            <p class='text-muted-foreground'>还没有文章。</p>
          )
        }
      </section>
    </div>
  </main>
</PageLayout>
