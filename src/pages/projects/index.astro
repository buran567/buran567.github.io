---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'now', text: '在做的事' },
  { depth: 2, slug: 'how-to-edit', text: '怎么添加新项目' }
]
---

<PageLayout title='项目' {headings}>
  <p data-en='A place to keep track of the things I am building.'>这里记录一些我在折腾的东西。</p>

  <h2 id='now'>在做的事</h2>
  <ProjectSection
    projects={[
      {
        name: '📝 这个博客',
        description: '用 Astro + Astro Theme Pure 搭建的静态博客，托管在 GitHub Pages 上。',
        links: [
          { type: 'github', href: 'https://github.com/buran567/buran567.github.io' },
          { type: 'site', href: 'https://buran567.github.io' }
        ]
      }
    ]}
  />

  <h2 id='how-to-edit'>怎么添加新项目</h2>
  <p>
    编辑 <code>src/pages/projects/index.astro</code>，在 <code>projects=[...]</code> 数组里照抄上面那一项再改内容即可。
    每项的 <code>links</code> 里 <code>type</code> 可以是 <code>github</code>、<code>site</code>、<code>doc</code>、
    <code>release</code>，会自动配上对应的图标。
  </p>
  <Button title='我的 GitHub' href='https://github.com/buran567' target='_blank' variant='ahead' />
</PageLayout>
