---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'me', text: '关于我' },
  { depth: 2, slug: 'blog', text: '关于这个博客' },
  { depth: 2, slug: 'contact', text: '联系我' }
]
---

<PageLayout title='关于' {headings}>
  <h2 id='me'>关于我</h2>
  <p data-en='Hi, I am Buran. This is where I write things down.'>你好，我是 Buran。这里是我记录想法的地方。</p>
  <p>
    这一段可以写你是谁、在做什么、对什么感兴趣。想改的话直接编辑
    <code>src/pages/about/index.astro</code>，把这几行字换成你自己的就行。
  </p>
  <p>一句话座右铭：<span data-en='Stay hungry, stay foolish.'>求知若饥，虚心若愚。</span></p>

  <h2 id='blog'>关于这个博客</h2>
  <p>这个博客是用下面这些技术搭起来的，全部免费：</p>
  <ul>
    <li><a href='https://astro.build/' target='_blank'>Astro</a> —— 生成静态网站的框架</li>
    <li>
      <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>Astro Theme Pure</a>
      —— 正在使用的主题（MIT / Apache 2.0 开源）
    </li>
    <li><a href='https://pages.github.com/' target='_blank'>GitHub Pages</a> —— 免费托管，自动部署</li>
  </ul>
  <p>
    写文章的流程很简单：在 <code>src/content/blog/</code> 里新建一个 Markdown 文件，提交推送到 GitHub，
    一两分钟后线上就会自动更新。
  </p>

  <h2 id='contact'>联系我</h2>
  <p data-en='The best way to reach me is GitHub.'>找到我最方便的方式是 GitHub。</p>
  <Button title='GitHub' href='https://github.com/buran567' target='_blank' variant='ahead' />
</PageLayout>
